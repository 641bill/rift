diff --git a/src/hotspot/share/runtime/riftRegionRuntime.cpp b/src/hotspot/share/runtime/riftRegionRuntime.cpp
new file mode 100644
index 00000000000..febe0cf8e80
--- /dev/null
+++ b/src/hotspot/share/runtime/riftRegionRuntime.cpp
@@ -0,0 +1,215 @@
+/*
